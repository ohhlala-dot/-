
import streamlit as st
import pandas as pd
import numpy as np
import plotly.graph_objects as go

# ==================================================
# 1. 페이지 설정 및 따뜻한 색감의 디자인
# ==================================================
st.set_page_config(
    page_title="동네별 인구 피라미드",
    page_icon="🏘️",
    layout="wide",
)

DATA_URL = (
    "https://raw.githubusercontent.com/first2022-cyber/"
    "contents/main/population_ts_yearly_gender.zip"
)

# 나이 라벨을 0세부터 100세 이상까지 순서대로 생성합니다.
AGE_LABELS = [f"{age}세" for age in range(101)]
AGE_LABELS[-1] = "100세 이상"

# 따뜻하고 부드러운 색상
MALE_COLOR = "#D88972"
FEMALE_COLOR = "#E9B65D"
BACKGROUND_COLOR = "#FFF9F2"
TEXT_COLOR = "#49382E"


# ==================================================
# 2. 데이터 불러오기
# ==================================================
@st.cache_data(show_spinner="인구 데이터를 불러오는 중입니다...")
def load_data():
    # URL의 ZIP 파일을 pandas로 읽습니다.
    # URL 끝이 .zip이므로 압축 형식이 자동으로 감지됩니다.
    df = pd.read_csv(DATA_URL, compression="zip")

    # 열 이름 양쪽의 공백을 제거합니다.
    df.columns = df.columns.astype(str).str.strip()

    # 연도를 숫자로 변환합니다.
    df["연도"] = pd.to_numeric(df["연도"], errors="coerce")

    # 연도가 없는 행은 제외하고 최신 연도를 찾습니다.
    df = df.dropna(subset=["연도"])
    latest_year = int(df["연도"].max())

    # 가장 최신 연도의 데이터만 남깁니다.
    df = df[df["연도"] == latest_year].copy()

    # 지역 이름의 공백을 정리합니다.
    for col in ["시도", "시군구", "동"]:
        df[col] = df[col].astype("string").str.strip()

    # 인구 열을 숫자로 변환합니다.
    # 쉼표가 포함된 숫자도 처리하고, 결측값은 0으로 바꿉니다.
    population_columns = [
        col for col in df.columns
        if col.startswith(("남_", "여_"))
    ]

    for col in population_columns:
        df[col] = pd.to_numeric(
            df[col].astype(str).str.replace(",", "", regex=False),
            errors="coerce",
        ).fillna(0)

    return df, latest_year


# ==================================================
# 3. 화면 디자인
# ==================================================
st.markdown(
    f"""
    <style>
    .stApp {{
        background-color: {BACKGROUND_COLOR};
        color: {TEXT_COLOR};
    }}

    h1, h2, h3 {{
        color: {TEXT_COLOR};
    }}

    div[data-testid="stMetric"] {{
        background-color: #FFFFFF;
        border: 1px solid #F0DDCA;
        border-radius: 14px;
        padding: 16px;
    }}

    div[data-testid="stSelectbox"] label {{
        color: {TEXT_COLOR};
        font-weight: 600;
    }}
    </style>
    """,
    unsafe_allow_html=True,
)

st.title("🏘️ 동네별 인구 피라미드")
st.markdown(
    "우리 동네의 연령별 인구 구성을 살펴보세요. "
    "남성은 왼쪽, 여성은 오른쪽에 표시됩니다."
)

st.divider()


# ==================================================
# 4. 데이터 로딩 및 오류 처리
# ==================================================
try:
    df, latest_year = load_data()
except Exception as e:
    st.error(
        "인구 데이터를 불러오지 못했습니다. "
        "인터넷 연결과 데이터 주소를 확인해 주세요."
    )
    st.exception(e)
    st.stop()

required_columns = ["연도", "시도", "시군구", "동"]

missing_columns = [
    col for col in required_columns
    if col not in df.columns
]

if missing_columns:
    st.error(
        f"데이터에 필요한 열이 없습니다: {missing_columns}"
    )
    st.stop()

st.caption(
    f"📅 분석 기준 연도: {latest_year}년 · "
    "데이터에서 확인된 가장 최신 연도"
)


# ==================================================
# 5. 시도 → 시군구 → 동 선택
# ==================================================
st.subheader("📍 지역 선택")

# 지역 이름은 가나다순으로 정렬합니다.
sido_options = sorted(
    df["시도"].dropna().unique().tolist()
)

if not sido_options:
    st.warning("선택할 수 있는 시도 데이터가 없습니다.")
    st.stop()

col1, col2, col3 = st.columns(3)

with col1:
    selected_sido = st.selectbox(
        "① 시도",
        options=sido_options,
        key="selected_sido",
    )

# 선택한 시도에 속하는 시군구만 표시합니다.
sigungu_data = df[df["시도"] == selected_sido]

sigungu_options = sorted(
    sigungu_data["시군구"].dropna().unique().tolist()
)

if not sigungu_options:
    st.warning("선택한 시도에 시군구 데이터가 없습니다.")
    st.stop()

with col2:
    selected_sigungu = st.selectbox(
        "② 시군구",
        options=sigungu_options,
        key="selected_sigungu",
    )

# 선택한 시도와 시군구에 속하는 동만 표시합니다.
dong_data = sigungu_data[
    sigungu_data["시군구"] == selected_sigungu
]

dong_options = sorted(
    dong_data["동"].dropna().unique().tolist()
)

if not dong_options:
    st.warning("선택한 시군구에 동 데이터가 없습니다.")
    st.stop()

with col3:
    selected_dong = st.selectbox(
        "③ 동",
        options=dong_options,
        key="selected_dong",
    )


# ==================================================
# 6. 선택한 동네의 인구 데이터 추출
# ==================================================
selected_data = df[
    (df["시도"] == selected_sido)
    & (df["시군구"] == selected_sigungu)
    & (df["동"] == selected_dong)
]

if selected_data.empty:
    st.warning("선택한 지역의 인구 데이터가 없습니다.")
    st.stop()

# 같은 지역이 여러 행으로 존재할 경우 연령별 인구를 합산합니다.
# 먼저 각 나이의 남녀 열이 실제로 존재하는지 확인합니다.
male_columns = [f"남_{age}세" for age in range(100)]
male_columns.append("남_100세 이상")

female_columns = [f"여_{age}세" for age in range(100)]
female_columns.append("여_100세 이상")

missing_population_columns = [
    col for col in male_columns + female_columns
    if col not in df.columns
]

if missing_population_columns:
    st.error(
        "일부 연령별 인구 열을 찾을 수 없습니다. "
        "실제 CSV의 열 이름을 확인해 주세요."
    )
    st.write("누락된 열 예시:", missing_population_columns[:10])
    st.stop()

# 각 연령대별 남녀 인구를 합산합니다.
population = selected_data[
    male_columns + female_columns
].sum()

male_population = np.array(
    [population[col] for col in male_columns],
    dtype=float,
)

female_population = np.array(
    [population[col] for col in female_columns],
    dtype=float,
)

# 인구 수는 막대그래프에 사용할 수 있도록 정수로 처리합니다.
male_population = np.rint(male_population).astype(int)
female_population = np.rint(female_population).astype(int)

# 남성은 왼쪽에 나타나도록 음수로 변환합니다.
male_negative = -male_population

total_male = int(male_population.sum())
total_female = int(female_population.sum())
total_population = total_male + total_female


# ==================================================
# 7. 핵심 지표 표시
# ==================================================
st.divider()

st.subheader(
    f"📊 {selected_sido} {selected_sigungu} {selected_dong} 인구 현황"
)

metric1, metric2, metric3 = st.columns(3)

metric1.metric(
    "전체 인구",
    f"{total_population:,}명",
)

metric2.metric(
    "남성 인구",
    f"{total_male:,}명",
)

metric3.metric(
    "여성 인구",
    f"{total_female:,}명",
)


# ==================================================
# 8. 인구 피라미드 가로 막대그래프
# ==================================================
fig = go.Figure()

# 남성: 음수 값을 사용해 가운데 기준선 왼쪽에 표시합니다.
fig.add_trace(
    go.Bar(
        y=AGE_LABELS,
        x=male_negative,
        name="남성",
        orientation="h",
        marker_color=MALE_COLOR,
        hovertemplate=(
            "나이: %{y}<br>"
            "남성 인구: %{customdata:,}명"
            "<extra></extra>"
        ),
        customdata=male_population,
    )
)

# 여성: 양수 값을 사용해 가운데 기준선 오른쪽에 표시합니다.
fig.add_trace(
    go.Bar(
        y=AGE_LABELS,
        x=female_population,
        name="여성",
        orientation="h",
        marker_color=FEMALE_COLOR,
        hovertemplate=(
            "나이: %{y}<br>"
            "여성 인구: %{x:,}명"
            "<extra></extra>"
        ),
    )
)

# 좌우 길이가 비교되도록 양쪽 가로축의 범위를 대칭으로 설정합니다.
max_population = max(
    int(male_population.max()),
    int(female_population.max()),
    1,
)

axis_limit = max_population * 1.12

# 음수로 표시한 남성 인구의 눈금은 양수 형태로 보여 줍니다.
tick_step = max(1, int(np.ceil(axis_limit / 5)))
tick_values = list(
    range(-int(np.ceil(axis_limit)), int(np.ceil(axis_limit)) + 1, tick_step)
)

# 좌우 축 범위가 정확히 대칭이 되도록 양 끝값을 직접 지정합니다.
tick_values = sorted(set(tick_values + [-int(np.ceil(axis_limit)), 0, int(np.ceil(axis_limit))]))

fig.update_layout(
    title={
        "text": "연령별 남녀 인구 분포",
        "x": 0.5,
        "xanchor": "center",
    },
    barmode="overlay",
    bargap=0.08,
    height=1900,
    paper_bgcolor=BACKGROUND_COLOR,
    plot_bgcolor="#FFFFFF",
    font=dict(
        family="Arial, sans-serif",
        size=12,
        color=TEXT_COLOR,
    ),
    legend=dict(
        orientation="h",
        yanchor="bottom",
        y=1.02,
        xanchor="center",
        x=0.5,
    ),
    margin=dict(l=95, r=45, t=100, b=70),
    xaxis=dict(
        title="인구 수 (명)",
        range=[-axis_limit, axis_limit],
        tickmode="array",
        tickvals=tick_values,
        ticktext=[f"{abs(v):,}" for v in tick_values],
        zeroline=True,
        zerolinewidth=2,
        zerolinecolor="#9B8172",
        gridcolor="#F1E7DE",
    ),
    yaxis=dict(
        title="나이",
        # 나이 라벨을 0세부터 100세 이상까지 그대로 고정합니다.
        # categoryorder의 크기순 정렬이나 축 반전 옵션을 사용하지 않습니다.
        categoryorder="array",
        categoryarray=AGE_LABELS,
        tickmode="array",
        tickvals=AGE_LABELS,
        ticktext=AGE_LABELS,
        # 첫 번째 카테고리인 0세가 아래쪽에 오도록 합니다.
        autorange="reversed",
        showgrid=False,
        automargin=True,
    ),
)

# 그래프를 화면에 표시합니다.
st.plotly_chart(fig, use_container_width=True)

st.caption(
    "※ 남성은 왼쪽, 여성은 오른쪽에 표시됩니다. "
    "가로축의 눈금은 양쪽 모두 인구 수의 절댓값입니다."
)

# ==================================================
# 9. 연령별 인구 표
# ==================================================
with st.expander("📋 연령별 인구 데이터 표 보기"):
    result_table = pd.DataFrame(
        {
            "나이": AGE_LABELS,
            "남성 인구": male_population,
            "여성 인구": female_population,
            "전체 인구": male_population + female_population,
        }
    )

    st.dataframe(
        result_table,
        hide_index=True,
        use_container_width=True,
    )

st.markdown(
    """
    <div style="
        text-align:center;
        color:#8A7567;
        padding:20px 0 5px 0;
        font-size:13px;
    ">
        동네별 인구 피라미드 · 최신 연도 기준
    </div>
    """,
    unsafe_allow_html=True,
)
